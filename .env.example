# Application Environment
ENVIRONMENT=development
DEBUG=True

# Security Secrets
SECRET_KEY=super-secret-production-grade-jwt-signing-key-student-ai-2026-xyz
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (SQLite default, or PostgreSQL for production)
DATABASE_URL=sqlite:///./student_ai.db
# DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/student_ai_db

# Redis Cache (Optional, defaults to in-memory fallback if unavailable)
REDIS_URL=redis://localhost:6379/0

# Default Admin Credentials
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@studentai.io
ADMIN_PASSWORD=Admin@12345

# Frontend API URL
VITE_API_URL=/api/v1
